# =====================================================================
# Frontend environment variables (Vite)
# =====================================================================
# Copy this file to `frontend/.env` and fill in real values.
#
# WARNING: every VITE_* variable is inlined into the production JavaScript
# bundle and is publicly readable by anyone who loads the site.
#
# NEVER put any of these here:
#   RAZORPAY_KEY_SECRET
#   SECRET_KEY
#   SMTP_PASSWORD
#   DATABASE_URL

# Base URL of the backend API (note the /api suffix).
VITE_API_URL=http://localhost:8000/api

# PUBLIC Razorpay key id only - rzp_test_... or rzp_live_...
# Leave blank to run checkout in clearly-labelled demo mode.
VITE_RAZORPAY_KEY_ID=rzp_test_SN42JAZonGi4X3
# Optional: AI shopping assistant via OpenRouter.
VITE_OPENROUTER_API_KEY=your_openrouter_api_key_here
VITE_OPENROUTER_MODEL=openai/gpt-4o-mini

