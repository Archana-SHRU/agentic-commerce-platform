# Backend Environment Variables
# Copy this file to `.env` in the backend/ directory and fill in real values.
# Never commit the actual .env file.

# --- Database ---------------------------------------------------------
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://user:password@localhost:5432/razorcart_ai
DATABASE_ECHO=False

# --- App ----------------------------------------------------------------
DEBUG=True
APP_NAME=RazorCart AI
APP_VERSION=0.1.0

# Frontend runs on this port (Vite dev server) - already included by default
# in CORS_ORIGINS in app/core/config.py, listed here for reference only.
FRONTEND_URL=http://localhost:5173

# --- AI/LLM Configuration ----------------------------------------------
VITE_OPENROUTER_API_KEY=your_openrouter_api_key
VITE_OPENROUTER_MODEL=~openai/gpt-4o-mini

# --- Future: Razorpay Configuration (not used yet) ----------------------
RAZORPAY_KEY_ID=your_razorpay_test_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
