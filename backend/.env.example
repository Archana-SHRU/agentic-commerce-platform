# =====================================================================
# Backend environment variables
# =====================================================================
# Copy this file to `backend/.env` and fill in real values.
# Never commit the actual .env file. This example must stay secret-free.
#
# The backend resolves .env from an absolute path based on the source tree,
# so it is found no matter which directory you launch uvicorn from. Both of
# these locations are read (backend/.env wins if a key appears in both):
#   <repo>/.env
#   <repo>/backend/.env
# You can also point at an explicit file with: ENV_FILE=/path/to/app.env

# --- Database ---------------------------------------------------------
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
#
# Notes:
#  * Do NOT forget the "/" before the database name.
#      wrong:  ...@localhost:5432razorcart_ai
#      right:  ...@localhost:5432/razorcart_ai
#  * "user" below is a PLACEHOLDER. Replace it with your real PostgreSQL
#    role, otherwise you will see:
#      password authentication failed for user "user"
#  * Percent-encode special characters in the password:
#      @ -> %40    : -> %3A    / -> %2F    ? -> %3F    # -> %23   % -> %25
#    e.g. the password  Pa@ss/word  becomes  Pa%40ss%2Fword
#  * Managed hosts that hand out a postgres:// URL are accepted and
#    normalised to postgresql:// automatically.
DATABASE_URL=postgresql://user:Shruti%400809@localhost:5432/razorcart_ai
DATABASE_ECHO=False

# --- App --------------------------------------------------------------
# Set DEBUG=False in production. DEBUG=True adds connection diagnostics to
# GET /api/health.
DEBUG=True
APP_NAME=RazorCart AI
APP_VERSION=0.1.0

# Base URL of the frontend. Used to build the password reset link sent by
# email, i.e. {FRONTEND_URL}/reset-password?token=...
# In production set this to your deployed frontend origin.
FRONTEND_URL=http://localhost:5173

# --- CORS -------------------------------------------------------------
# Comma-separated list of browser origins allowed to call this API.
# Add your deployed frontend domain here when you deploy, e.g.
#   CORS_ORIGINS=https://shop.example.com,https://www.shop.example.com
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# --- Authentication / JWT ---------------------------------------------
# REQUIRED for signup/login/forgot-password to work.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Deliberately has no default: /api/auth/* returns 503 while it is unset
# rather than signing tokens with a predictable key.
SECRET_KEY=iVpzpIp43YyuUhKGx8_u55YRm0iWYHeYe-hwRTEwlkQ
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# How long a password reset link stays valid, in minutes.
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# --- Razorpay ---------------------------------------------------------
# Both values are backend-only. RAZORPAY_KEY_SECRET is used solely for
# server-side signature verification and is never returned to any client.
# While these are unset, POST /api/payments/create-order returns 503 and
# checkout falls back to honest, clearly-labelled demo mode.
RAZORPAY_KEY_ID=rzp_test_SN42JAZonGi4X3
RAZORPAY_KEY_SECRET=7V4uSKzgOy08rV9DAk5FIIWo

# --- SMTP / Email -----------------------------------------------------
# Required for the forgot-password flow. Until SMTP_HOST and
# SMTP_FROM_EMAIL are set, POST /api/auth/forgot-password returns a clear
# 503 configuration error instead of claiming an email was sent.
#
# Gmail example:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=you@gmail.com
#   SMTP_PASSWORD=<16-character Google App Password>
#   SMTP_FROM_EMAIL=you@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=archanashruti08@gmail.com
SMTP_PASSWORD=necl qutb hsaq crxp
SMTP_FROM_EMAIL=archanashruti08@gmail.com
SMTP_FROM_NAME=RazorCart AI
SMTP_USE_TLS=true